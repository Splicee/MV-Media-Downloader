<UserControl
    x:Class="MVMediaStudio.Views.ConversionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="clr-namespace:MVMediaStudio.UI"
    d:DesignHeight="900"
    d:DesignWidth="1360"
    mc:Ignorable="d">
    <Grid>
        <ScrollViewer
            x:Name="PageScroll"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel
                x:Name="ConversionContent"
                MaxWidth="1560"
                Margin="32,28,32,34"
                HorizontalAlignment="Stretch">
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PageTitleStyle}" Text="Převést soubory" />
                        <TextBlock
                            Margin="0,5,0,0"
                            FontSize="13"
                            Foreground="{DynamicResource Muted}"
                            Text="Sjednoť až 20 videí do jednoho formátu a kodeku."
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <Button
                        x:Name="RecommendedSettingsButton"
                        Grid.Column="1"
                        VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Text="&#xE73E;" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Doporučené nastavení" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Fronta souborů" />
                            <TextBlock
                                x:Name="ConversionCount"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource Muted}"
                                Text="0 / 20" />
                        </Grid>

                        <Grid
                            x:Name="ConversionListHost"
                            MinHeight="230"
                            AllowDrop="True">
                            <DataGrid
                                x:Name="ConversionGrid"
                                MinHeight="230"
                                MaxHeight="520"
                                AlternationCount="2"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserDeleteRows="False"
                                CanUserResizeRows="False"
                                CellStyle="{StaticResource MediaDataGridCellStyle}"
                                ColumnHeaderStyle="{StaticResource MediaDataGridHeaderStyle}"
                                EnableColumnVirtualization="True"
                                EnableRowVirtualization="True"
                                HeadersVisibility="Column"
                                IsReadOnly="True"
                                RowStyle="{StaticResource MediaDataGridRowStyle}"
                                SelectionMode="Single"
                                SelectionUnit="FullRow"
                                Style="{StaticResource MediaDataGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="2.2*"
                                        Binding="{Binding FileName}"
                                        Header="Soubor" />
                                    <DataGridTextColumn
                                        x:Name="ConversionCodecColumn"
                                        Width="2*"
                                        Binding="{Binding CodecDetails}"
                                        Header="Zdrojový kodek" />
                                    <DataGridTextColumn
                                        Width="1.1*"
                                        Binding="{Binding Status}"
                                        Header="Stav" />
                                    <DataGridTemplateColumn Width="1.2*" Header="Průběh">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid>
                                                    <ProgressBar
                                                        Height="6"
                                                        VerticalAlignment="Center"
                                                        Maximum="100"
                                                        Minimum="0"
                                                        Value="{Binding Progress}" />
                                                    <TextBlock
                                                        Margin="0,0,0,16"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        FontSize="10"
                                                        Text="{Binding ProgressText}" />
                                                </Grid>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel
                                x:Name="ConversionEmptyPanel"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="24"
                                    Foreground="{DynamicResource Muted}"
                                    Text="&#xE710;" />
                                <TextBlock
                                    Margin="0,9,0,3"
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource SmallHeadingStyle}"
                                    Text="Přetáhni sem videa" />
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    Style="{StaticResource MutedTextStyle}"
                                    Text="nebo použij tlačítko Přidat soubory" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                            <Button x:Name="AddConversionFilesButton">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="14"
                                        Text="&#xE710;" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Přidat soubory" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ConversionRemoveButton" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="14"
                                        Text="&#xE74D;" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Odebrat vybraný" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ConversionClearButton" Margin="8,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="14"
                                        Text="&#xE894;" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Vyčistit frontu" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,14,0,0"
                    Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Výstup" />
                        <ui:AdaptiveGrid
                            Margin="0,16,0,0"
                            ColumnSpacing="12"
                            ItemMinWidth="285"
                            MaximumColumns="3"
                            RowSpacing="14">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="FORMÁT" />
                                <ComboBox x:Name="ConversionFormatCombo" />
                            </StackPanel>
                            <StackPanel x:Name="ConversionCodecField">
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="VIDEO KODEK" />
                                <ComboBox x:Name="ConversionCodecCombo" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="CÍLOVÁ SLOŽKA" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox
                                        x:Name="ConversionFolderBox"
                                        MinHeight="38"
                                        IsReadOnly="True"
                                        VerticalContentAlignment="Center" />
                                    <Button
                                        x:Name="BrowseConversionFolderButton"
                                        Grid.Column="1"
                                        Margin="8,0,0,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe MDL2 Assets"
                                                FontSize="14"
                                                Text="&#xE8B7;" />
                                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Vybrat" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="OpenConversionFolderButton"
                                        Grid.Column="2"
                                        Margin="6,0,0,0"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTip="Otevřít výstupní složku">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="16"
                                            Text="&#xE838;" />
                                    </Button>
                                </Grid>
                            </StackPanel>
                        </ui:AdaptiveGrid>

                        <ui:AdaptiveGrid
                            x:Name="ConversionCodecNoticePanel"
                            Margin="0,18,0,0"
                            ColumnSpacing="8"
                            ItemMinWidth="245"
                            MaximumColumns="3"
                            RowSpacing="8">
                            <Border Padding="12" Background="{DynamicResource SurfaceAlt}" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="11.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Success}"
                                        Text="H.264" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        Style="{StaticResource MutedTextStyle}"
                                        Text="Nejkompatibilnější s většinou zařízení." />
                                </StackPanel>
                            </Border>
                            <Border Padding="12" Background="{DynamicResource SurfaceAlt}" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="11.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Warning}"
                                        Text="H.265" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        Style="{StaticResource MutedTextStyle}"
                                        Text="Některé starší televize ho nepřehrají." />
                                </StackPanel>
                            </Border>
                            <Border Padding="12" Background="{DynamicResource SurfaceAlt}" CornerRadius="6">
                                <StackPanel>
                                    <TextBlock
                                        FontSize="11.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource Danger}"
                                        Text="AV1" />
                                    <TextBlock
                                        Margin="0,3,0,0"
                                        Style="{StaticResource MutedTextStyle}"
                                        Text="Na velké části starších zařízení nepůjde." />
                                </StackPanel>
                            </Border>
                        </ui:AdaptiveGrid>
                    </StackPanel>
                </Border>

                <Border
                    x:Name="ConversionAdvancedPanel"
                    Margin="0,14,0,0"
                    Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SmallHeadingStyle}" Text="Pokročilé řízení kvality" />
                        <ui:AdaptiveGrid
                            Margin="0,14,0,0"
                            ColumnSpacing="10"
                            ItemMinWidth="190"
                            MaximumColumns="5"
                            RowSpacing="12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="ŘÍZENÍ KVALITY" />
                                <ComboBox x:Name="ConversionRateCombo" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="CRF" />
                                <ComboBox x:Name="ConversionCrfCombo" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="VIDEO BITRATE" />
                                <ComboBox x:Name="ConversionVideoBitrateCombo" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="ZVUK KODEK" />
                                <ComboBox x:Name="ConversionAudioCodecCombo" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource FieldLabelStyle}" Text="ZVUK BITRATE" />
                                <ComboBox x:Name="ConversionAudioBitrateCombo" />
                            </StackPanel>
                        </ui:AdaptiveGrid>
                    </StackPanel>
                </Border>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="ConversionStartButton"
                        MinWidth="170"
                        Style="{StaticResource PrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Text="&#xE768;" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Spustit konverzi" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ConversionCancelButton" Grid.Column="1" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Text="&#xE71A;" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Zrušit" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="ConversionReportButton"
                        Grid.Column="3"
                        Margin="0,0,8,0"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Text="&#xE8BD;" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Nahlásit chybu" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ConversionLogToggle" Grid.Column="4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="14"
                                Text="&#xE756;" />
                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="Zobrazit log" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border
                    Margin="0,14,0,0"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Name="ConversionStatusTitle"
                            Style="{StaticResource SmallHeadingStyle}"
                            Text="Fronta je prázdná" />
                        <TextBlock
                            x:Name="ConversionStatusDetail"
                            Grid.Row="1"
                            Margin="0,4,0,12"
                            Style="{StaticResource MutedTextStyle}"
                            Text="Přidej jeden nebo více souborů." />
                        <ProgressBar
                            x:Name="ConversionOverallProgress"
                            Grid.Row="2"
                            Maximum="100"
                            Minimum="0"
                            Value="0" />
                    </Grid>
                </Border>

                <Border
                    x:Name="ConversionLogCard"
                    Margin="0,14,0,0"
                    Style="{StaticResource CardStyle}"
                    Visibility="Collapsed">
                    <TextBox
                        x:Name="ConversionLogBox"
                        MaxHeight="260"
                        AcceptsReturn="True"
                        IsReadOnly="True"
                        Style="{StaticResource ConsoleTextBoxStyle}" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
