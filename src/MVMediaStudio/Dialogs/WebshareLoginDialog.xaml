<Window
    x:Class="MVMediaStudio.UI.WebshareLoginDialog"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Přihlášení Webshare"
    Width="460"
    Height="380"
    MinWidth="460"
    MinHeight="380"
    Background="{DynamicResource WindowBackground}"
    FontFamily="Segoe UI"
    Foreground="{DynamicResource Text}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock
            FontSize="21"
            FontWeight="SemiBold"
            Text="Webshare účet" />
        <StackPanel Grid.Row="1" Margin="0,13,0,0">
            <TextBlock Margin="0,0,0,5" FontSize="11.5" Text="Uživatelské jméno nebo e-mail" />
            <TextBox x:Name="UserNameBox" MinHeight="38" />
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,13,0,0">
            <TextBlock Margin="0,0,0,5" FontSize="11.5" Text="Heslo" />
            <PasswordBox x:Name="PasswordBox" MinHeight="38" Padding="12,8" />
        </StackPanel>
        <CheckBox
            x:Name="RememberCheck"
            Grid.Row="3"
            Margin="0,13,0,0"
            Content="Zapamatovat relaci v tomto počítači"
            IsChecked="True" />
        <TextBlock
            Grid.Row="4"
            Margin="0,10,0,0"
            FontSize="11.5"
            Foreground="{DynamicResource Muted}"
            Text="Heslo se neukládá. Přihlašovací relace je chráněná účtem Windows."
            TextWrapping="Wrap" />
        <StackPanel
            Grid.Row="5"
            Margin="0,18,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button MinWidth="90" Content="Zrušit" IsCancel="True" />
            <Button
                MinWidth="100"
                Margin="8,0,0,0"
                Click="LoginClick"
                Content="Přihlásit"
                IsDefault="True"
                Style="{StaticResource PrimaryButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
