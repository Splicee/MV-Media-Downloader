<Window
    x:Class="MVMediaStudio.UI.ReportReadyDialog"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Diagnostický report"
    Width="620"
    Height="350"
    MinWidth="620"
    MinHeight="350"
    Background="{DynamicResource WindowBackground}"
    FontFamily="Segoe UI"
    Foreground="{DynamicResource Text}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock
            FontSize="21"
            FontWeight="SemiBold"
            Text="Diagnostický soubor byl uložen" />
        <TextBlock
            Grid.Row="1"
            Margin="0,8,0,0"
            FontSize="13"
            Text="Přilož tento .txt soubor k e-mailu správci aplikace, nebo k novému hlášení na GitHubu."
            TextWrapping="Wrap" />
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="ReportPathBox"
                MinHeight="38"
                IsReadOnly="True"
                VerticalContentAlignment="Center" />
            <Button
                Grid.Column="1"
                Margin="8,0,0,0"
                Click="RevealFileClick"
                ToolTip="Zobrazit uložený report v Průzkumníku">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Text="&#xE838;" />
                    <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="Otevřít složku" />
                </StackPanel>
            </Button>
        </Grid>
        <TextBlock
            Grid.Row="3"
            Margin="0,11,0,0"
            FontSize="11.5"
            Foreground="{DynamicResource Muted}"
            Text="Před odesláním můžeš obsah zkontrolovat. Tokeny, klíče, osobní cesty a parametry URL jsou automaticky odstraněné."
            TextWrapping="Wrap" />
        <Grid Grid.Row="5" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="1"
                MinWidth="86"
                Content="Zavřít"
                IsCancel="True" />
            <Button
                Grid.Column="2"
                MinWidth="104"
                Margin="8,0,0,0"
                Click="EmailClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Text="&#xE715;" />
                    <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="E-mail" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="3"
                MinWidth="112"
                Margin="8,0,0,0"
                Click="GitHubClick"
                Style="{StaticResource PrimaryButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="14"
                        Text="&#xE71B;" />
                    <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" Text="GitHub" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Window>
