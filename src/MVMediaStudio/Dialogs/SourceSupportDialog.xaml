<Window
    x:Class="MVMediaStudio.UI.SourceSupportDialog"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:MVMediaStudio.UI"
    Title="Podporované weby"
    Width="920"
    Height="720"
    MinWidth="720"
    MinHeight="560"
    Background="{DynamicResource WindowBackground}"
    FontFamily="Segoe UI"
    Foreground="{DynamicResource Text}"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock
                FontSize="23"
                FontWeight="SemiBold"
                Text="Podporované zdroje" />
            <TextBlock
                Margin="0,6,0,0"
                FontSize="12.5"
                Foreground="{DynamicResource Muted}"
                Text="Zelené zdroje prošly živou kontrolou metadat. Upozornění ukazují přihlášení, DRM nebo změnu přehrávače."
                TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer
            Grid.Row="1"
            Margin="0,20,0,16"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock
                            FontSize="14"
                            FontWeight="SemiBold"
                            Text="České a slovenské zdroje" />
                        <ItemsControl x:Name="CzechSources" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ui:AdaptiveGrid
                                        ColumnSpacing="12"
                                        ItemMinWidth="360"
                                        MaximumColumns="2"
                                        RowSpacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,8,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            Margin="0,3,9,0"
                                            VerticalAlignment="Top"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="11"
                                            Foreground="{Binding StatusBrush}"
                                            Text="{Binding Glyph}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock
                                                FontSize="12"
                                                FontWeight="SemiBold"
                                                Text="{Binding Name}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource Muted}"
                                                Text="{Binding Detail}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ui:AdaptiveGrid
                    Margin="0,12,0,0"
                    ColumnSpacing="12"
                    ItemMinWidth="320"
                    MaximumColumns="3"
                    RowSpacing="12">
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Video platformy" />
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource Muted}"
                                LineHeight="20"
                                Text="YouTube · Vimeo · Dailymotion&#x0a;Twitch · Kick · TikTok · Instagram&#x0a;Facebook · X · Reddit&#x0a;Rumble · Streamable"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Hudba a podcasty" />
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource Muted}"
                                LineHeight="20"
                                Text="SoundCloud · Bandcamp&#x0a;Mixcloud · Apple Podcasts&#x0a;Další zdroje podporované yt-dlp"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Soubory" />
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource Muted}"
                                LineHeight="20"
                                Text="Webshare&#x0a;Přímé odkazy na video a audio&#x0a;Přímé odkazy na archivy a dokumenty"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </ui:AdaptiveGrid>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock
                FontSize="11.5"
                Foreground="{DynamicResource Muted}"
                Text="Cookies z prohlížeče pomáhají se souhlasem webu a běžným přihlášením. Prima+ vyžaduje účet podporovaný přímo yt-dlp. Aplikace neobchází DRM ani placený přístup."
                TextWrapping="Wrap" />
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="1"
                    MinWidth="150"
                    Click="OpenFullListClick"
                    Content="Úplný seznam yt-dlp" />
                <Button
                    Grid.Column="2"
                    MinWidth="90"
                    Margin="8,0,0,0"
                    Content="Zavřít"
                    IsCancel="True"
                    IsDefault="True" />
            </Grid>
        </Grid>
    </Grid>
</Window>
