<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>MVMediaStudio.Tests</RootNamespace>
    <AssemblyName>MVMediaStudio.Tests</AssemblyName>
    <StartupObject>MVMediaStudio.Tests.CoreTests</StartupObject>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\CoreTests.cs" Link="CoreTests.cs" />
    <Compile Include="..\DownloadControlTests.cs" Link="DownloadControlTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MVMediaStudio\MVMediaStudio.csproj" />
  </ItemGroup>
</Project>
